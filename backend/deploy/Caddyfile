# Caddy runs on the host, not in Compose. After a change:
#   sudo cp backend/deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

# HTTP/1.1 and HTTP/2 only (TCP), no HTTP/3 (UDP). On some networks the UDP packets of HTTP/3 get
# lost after the first requests; the browser does not fall back to TCP and the page half-loads.
{
	servers {
		protocols h1 h2
	}
}

kulturprogramm.eu {
	# Umami visitor statistics, from this domain: the tracker script /k/s.js and its events /k/e.
	# The browser contacts no other host. Names: TRACKER_SCRIPT_NAME, COLLECT_API_ENDPOINT in
	# compose.yaml. Everything else under /k answers 404, so the Umami dashboard and API stay on
	# stats.kulturprogramm.eu.
	handle_path /k/* {
		# The recorder (replays and heatmaps): Umami serves it as /recorder.js and has no setting
		# for the name. /r.js, because ad blockers block "recorder.js".
		handle /r.js {
			rewrite * /recorder.js
			reverse_proxy localhost:3001
		}
		# /api/record: the recordings; /api/websites/<id>/recorder: the recorder's settings
		# (sample rate, masking). The recorder sends to the folder it loads from, so /k/api/….
		@umami path /s.js /e /api/record /api/websites/*/recorder
		handle @umami {
			reverse_proxy localhost:3001
		}
		handle {
			respond 404
		}
	}
	handle {
		reverse_proxy localhost:3000
	}
}

# The Umami dashboard (login: Umami's own accounts).
stats.kulturprogramm.eu {
	reverse_proxy localhost:3001
}
